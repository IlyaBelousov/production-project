{
  "compilerOptions": {
    "outDir": "./dist/",
    "noImplicitAny": true,
    "target": "es2017",
    "jsx": "react-jsx",
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
       "*": ["./src/*"]
    },
    "plugins": [{ "name": "typescript-plugin-css-modules" }],
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "module": "ESNext"
  },
  "include": ["./config/jest/jest-setup.js", "src"],
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS"
    }
  },
  "lib": ["es2017"]
}
